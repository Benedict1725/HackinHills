DATABASE_URL=sqlite:///./leakproof.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI provider: choose ONE (ollama or anthropic) ---
AI_PROVIDER=ollama
# Must match a model you have pulled, e.g. `ollama pull llama3.2:3b`
AI_MODEL=llama3.2:3b
OLLAMA_HOST=http://127.0.0.1:11434

# For AI_PROVIDER=anthropic: set AI_MODEL (e.g. claude-haiku-5-5) and the key below.
# Never commit your real key. It is read only by the backend.
ANTHROPIC_API_KEY=

AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=300
